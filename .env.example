# Copy this file to ".env" (same folder) and edit. Never commit ".env".
# Restart "npm run dev" after changing it.

# true  = sample data, no backend needed (good for a quick look)
# false = send real requests to the backend (start the backend first)
VITE_USE_MOCK=false

# Main backend (Task-4-Multi-Agent-Architecture). Used by the dev server for /validate
VITE_PROXY_TARGET=http://localhost:8000

# Optional: also show live results from the Web Search Agent (Task 3).
# Needs the Task 3 server running on VITE_SEARCH_PROXY_TARGET and a Tavily key in its .env
VITE_ENABLE_WEB_SEARCH=false
VITE_SEARCH_PROXY_TARGET=http://localhost:8001

# Leave empty in development (the dev server forwards requests).
# For a deployed backend, set the full URL, e.g. https://my-backend.example.com
VITE_API_URL=
